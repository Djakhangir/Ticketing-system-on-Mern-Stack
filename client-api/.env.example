# ---- Core ----
PORT=3001
NODE_ENV=development

# ---- Datastores ----
# Local docker-compose uses service names (mongo, redis).
# For a managed DB (e.g. MongoDB Atlas) paste the full SRV connection string.
MONGO_URL=mongodb://mongo:27017/TicketingSystemAJ
REDIS_URL=redis://redis:6379

# ---- Auth secrets (CHANGE THESE in production) ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_SECRET_EXP_DAY=30

# ---- Frontend origin allowed to call this API (CORS) ----
# Comma-separated list. Leave blank to allow all (dev only).
CLIENT_ORIGIN=http://localhost:3000

# ---- Email (Nodemailer) ----
# Leave blank to auto-use an Ethereal test inbox in non-production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Apartment Care <no-reply@yourdomain.com>"

# ---- SMS (optional, stubbed until provider configured) ----
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
